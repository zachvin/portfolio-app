{
  "hosting": {
    "target": "zach-vincent",
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**"
    ],
    "redirects": [
      { "source": "/r", "destination": "/", "type": 302 },
      { "source": "/li", "destination": "/", "type": 302 },
      { "source": "/gh", "destination": "/", "type": 302 }
    ],
    "rewrites": [
      {
        "source": "**",
        "destination": "/index.html"
      }
    ]
  }
}
